# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Chi Portal"

# Database (Supabase)
DATABASE_URL=postgresql://postgres:c!a2PtYc7byC%F@localhost:5432/chi_portal
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (Upstash)
REDIS_URL=redis://default:password@localhost:6379
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters
MAGIC_LINK_SECRET=your-magic-link-secret-minimum-32-characters

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (for magic links)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Chi Portal <noreply@chiportal.com>"

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=chi-portal-assets
R2_PUBLIC_URL=https://assets.chiportal.com

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# AI Services
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# AI Rate Limits (per user per month)
AI_CHAT_LIMIT_FREE=10
AI_CHAT_LIMIT_PREMIUM=500
AI_JOURNAL_LIMIT_FREE=20
AI_JOURNAL_LIMIT_PREMIUM=1000

# Feature Flags
ENABLE_AI_CHAT=true
ENABLE_COMMUNITY=true
ENABLE_YANG_REALM=true
ENABLE_ACHIEVEMENTS=true

# Analytics (optional)
POSTHOG_KEY=phc_your_posthog_key
MIXPANEL_TOKEN=your_mixpanel_token

# Monitoring (optional)
SENTRY_DSN=https://your-key@sentry.io/project-id
LOGTAIL_SOURCE_TOKEN=your_logtail_token